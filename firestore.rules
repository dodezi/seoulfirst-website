rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 최고관리자(원장 등): 로그인 + 등록된 관리자 이메일만
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
             'dodezi82@gmail.com',
             'seoulfirst2023@gmail.com'
           ];
    }

    // 승인·재직 중인 직원인지 (가입 승인되어 active=true)
    function isActiveUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
        && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.get('active', false) == true;
    }

    // 페이지 단위 권한: 승인·재직 직원이 해당 페이지(page) 권한을 가졌는지
    function hasPagePerm(page) {
      return isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.get('perms', {}).get(page, false) == true;
    }

    // 살펴보기 전용(읽기만) 계정인지 — viewer=true 이면 모든 쓰기 차단(데모/견학용)
    function isViewer() {
      return isActiveUser()
        && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.get('viewer', false) == true;
    }
    // 해당 페이지를 '수정'할 수 있는가 = 관리자 또는 (권한 있고 + 뷰어가 아님)
    function canEdit(page) { return isAdmin() || (hasPagePerm(page) && !isViewer()); }

    // 공지사항: 누구나 읽기 / 관리자만 작성·수정·삭제
    match /notices/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 온라인 예약:
    //  - 공개 생성(예약폼)은 허용하되, 필드 화이트리스트·길이·금지문자(<>)로 검증 → 저장형 XSS·스팸 차단
    //  - 직원/관리자는 추가 필드(확정일시·차트번호 등) 포함 생성 가능 (뷰어 제외)
    //  - 조회는 관리자·'예약' 권한 직원 / 수정·삭제는 뷰어 제외
    match /bookings/{doc} {
      function safeStr(v, max) {
        return v is string && v.size() <= max && !v.matches('[\\s\\S]*[<>][\\s\\S]*');
      }
      function validPublicBooking() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name','phone','date','time','service','memo','status','createdAt'])
          && safeStr(d.name, 40)  && d.name.size()  > 0
          && safeStr(d.phone, 20) && d.phone.size() > 0
          && safeStr(d.get('date',''), 20)
          && safeStr(d.get('time',''), 30)
          && safeStr(d.get('service',''), 200)
          && safeStr(d.get('memo',''), 1000)
          && d.status == '대기중';
      }
      allow create: if validPublicBooking() || canEdit('booking');
      allow read:          if isAdmin() || hasPagePerm('booking');
      allow update, delete: if canEdit('booking');
    }

    // 검진 환자 정보 (민감): 관리자·'검진' 권한 직원
    match /checkup_patients/{doc} {
      allow read:  if isAdmin() || hasPagePerm('checkup');
      allow write: if canEdit('checkup');
    }

    // 거래명세서 (민감)
    match /invoices/{doc} {
      allow read:  if isAdmin() || hasPagePerm('invoice');
      allow write: if canEdit('invoice');
    }

    // 마약류 기록 (민감)
    match /narcotics_records/{doc} {
      allow read:  if isAdmin() || hasPagePerm('narcotics');
      allow write: if canEdit('narcotics');
    }

    // 점심 영수증 (서버 Functions는 admin SDK라 규칙 우회)
    match /lunch_receipts/{doc} {
      allow read:  if isAdmin() || hasPagePerm('lunch');
      allow write: if canEdit('lunch');
    }

    // 장비 수리·관리(AS 이력)
    match /equipment_repairs/{doc} {
      allow read:  if isAdmin() || hasPagePerm('equip');
      allow write: if canEdit('equip');
    }

    // 복약·처방 정리(텔레그램 수신): 관리자·'의약품'·'검진' 권한 직원
    match /meds_records/{doc} {
      allow read:  if isAdmin() || hasPagePerm('meds') || hasPagePerm('checkup');
      allow write: if isAdmin() || ((hasPagePerm('meds') || hasPagePerm('checkup')) && !isViewer());
    }

    // 직원 명부 (연차 관리): 재직 직원은 읽기 / 쓰기는 '연차' 권한 직원(뷰어 제외)
    match /staff/{doc} {
      allow read:  if isAdmin() || isActiveUser();
      allow write: if canEdit('leaves');
    }

    // 직원 연차 기록
    match /staff_leaves/{doc} {
      allow read:           if isAdmin() || isActiveUser();
      allow create, update: if canEdit('leaves');
      allow delete:         if request.auth != null && request.auth.token.email == 'dodezi82@gmail.com';
    }

    // 임시공휴일(휴무일)
    match /custom_holidays/{doc} {
      allow read:  if isAdmin() || isActiveUser();
      allow write: if isAdmin() || ((hasPagePerm('booking') || hasPagePerm('leaves')) && !isViewer());
    }

    // 포털 사용자·권한
    match /users/{email} {
      allow read:   if (request.auth != null && request.auth.token.email == 'dodezi82@gmail.com')
                    || (request.auth != null && request.auth.token.email == email);
      allow create: if (request.auth != null && request.auth.token.email == 'dodezi82@gmail.com')
                    || (request.auth != null
                        && request.auth.token.email == email
                        && request.resource.data.status == 'pending'
                        && request.resource.data.active == false
                        && request.resource.data.perms.size() == 0);
      allow update, delete: if request.auth != null && request.auth.token.email == 'dodezi82@gmail.com';
    }

    // 앱 공용 설정(AI 키 등): 관리자 전용
    match /app_config/{doc} {
      allow read, write: if isAdmin();
    }

    // 검진 CRM 공식 문구(템플릿)
    match /crm_templates/{doc} {
      allow read:  if isAdmin() || hasPagePerm('crm') || hasPagePerm('booking');
      allow write: if isAdmin() || ((hasPagePerm('crm') || hasPagePerm('booking')) && !isViewer());
    }

    // 검진 CRM 발송 설정(솔라피): 관리자 전용
    match /crm_config/{doc} {
      allow read, write: if isAdmin();
    }

    // 검사 전 안내 자동발송 일별 로그: 함수(admin SDK)가 기록, 화면은 읽기만
    match /crm_auto_log/{doc} {
      allow read:  if isAdmin() || hasPagePerm('crm') || hasPagePerm('booking');
      allow write: if false;
    }

    // 변경·접속 이력 (감사 로그): 추가(append)만 가능, 수정·삭제 불가
    match /audit_logs/{doc} {
      allow create: if isAdmin() || isActiveUser();
      allow read:   if request.auth != null && request.auth.token.email == 'dodezi82@gmail.com';
      allow update, delete: if false;
    }

    // 그 외 모든 경로: 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
